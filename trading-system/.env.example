# Copy to .env (git-ignored). NEVER commit real values.
# Use read-only keys wherever the provider allows. Crypto keys: withdrawals DISABLED.

# --- Mode safety (leave as paper until the go-live gates in docs/TESTING.md pass) ---
TRADING_GLOBAL_MODE=paper

# --- India: order broker (e.g. Zerodha Kite Connect "Personal", free, orders only) ---
KITE_API_KEY=
KITE_API_SECRET=

# --- India: data broker (free market data; e.g. Angel One SmartAPI or Fyers) ---
DATA_BROKER_API_KEY=
DATA_BROKER_CLIENT_ID=
DATA_BROKER_TOTP_SECRET=

# --- US: Alpaca (paper keys first) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# --- Crypto (via CCXT; withdrawals disabled) ---
CRYPTO_EXCHANGE_ID=
CRYPTO_API_KEY=
CRYPTO_API_SECRET=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM Brain (OFF by default; see docs/BRAIN_AND_COSTS.md) ---
BRAIN_ENABLED=false
LLM_PROVIDER=anthropic   # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAIN_DAILY_BUDGET_INR=50
BRAIN_MONTHLY_BUDGET_INR=500
